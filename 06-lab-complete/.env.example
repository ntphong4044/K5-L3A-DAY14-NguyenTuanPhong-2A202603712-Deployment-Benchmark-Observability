# ============================================================
# Mẫu biến môi trường — copy thành .env (đã nằm trong .gitignore).
# KHÔNG ghi secret thật ở đây; đặt AGENT_API_KEY thật trên nền tảng cloud.
# ============================================================
PORT=8000
ENVIRONMENT=development

# Security — API key client phải gửi qua header X-API-Key
AGENT_API_KEY=change-me-dev-key

# Redis cho rate limit + cost guard (stateless)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request / 60s cho mỗi API key
RATE_LIMIT_PER_MINUTE=60

# Cost guard: ngân sách LLM
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=30.0
